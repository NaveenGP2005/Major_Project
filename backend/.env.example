# ── Free-Tier Database ($0) ──────────────────────────────────────────────────
# Default to local SQLite out-of-the-box:
DATABASE_URL=sqlite+aiosqlite:///./memory_engine.db

# Or switch to free Neon.tech Cloud PostgreSQL with pgvector:
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-odd-recipe-bb5i3f2r-pooler.c-15.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Free-Tier LLM Provider ($0) ──────────────────────────────────────────────
# Provider A: Groq Cloud Free Tier
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Provider B: Google AI Studio Free Tier (Optional fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Local Free Embeddings (CPU, $0) ──────────────────────────────────────────
EMBEDDING_DIM=384
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ── General App Settings ─────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=free-tier-dev-secret-key-change-in-production
